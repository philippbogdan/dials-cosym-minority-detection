+def test_minority_in_a_continuously_varying_majority():
+    # the majority varies continuously (one shared pattern, normal states): the two data
+    # sets set apart are found and the majority is not split
+    rng = np.random.default_rng(11)
+    nref = 3000
+    mu = rng.exponential(1.0, nref)
+    shared, minority_pattern = rng.standard_normal((2, nref))
+    rows = [mu + 0.15 * rng.standard_normal() * shared for _ in range(12)]
+    rows += [mu + 0.5 * minority_pattern for _ in range(2)]
+    y = np.array(rows) + 0.2 * rng.standard_normal((14, nref))
+    v = np.full(y.shape, 0.04)
+    m = rng.random(y.shape) < 0.8
+    assert detect(y, v, m) == [list(range(12)), [12, 13]]
+
