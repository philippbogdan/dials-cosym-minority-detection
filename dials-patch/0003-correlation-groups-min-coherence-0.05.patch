From fe1c9f14d6e7b1191c453a2124e8fe5470c0809d Mon Sep 17 00:00:00 2001
From: Philipp Bogdan <174341097+philippbogdan@users.noreply.github.com>
Date: Sat, 3 Oct 2026 02:23:03 +0100
Subject: [PATCH] correlation groups: min_coherence default 0.05

On the cryogenic insulin data (12 bovine, 12 porcine, 12 human crystals) the strongest
significant group of crystals of one species reaches a coherence of 0.038 (two porcine
crystals of a small-cell sub-population, 1 degree per crystal); 0.05 keeps a margin above it.
Tests moved to minorities clearly above the default.
---
 src/dials/algorithms/correlation/analysis.py |  2 +-
 src/dials/algorithms/correlation/groups.py   |  2 +-
 tests/algorithms/correlation/test_groups.py  | 10 +++++-----
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/src/dials/algorithms/correlation/analysis.py b/src/dials/algorithms/correlation/analysis.py
index 73a77d4..1bfb3fb 100644
--- a/src/dials/algorithms/correlation/analysis.py
+++ b/src/dials/algorithms/correlation/analysis.py
@@ -77,7 +77,7 @@
       .type = int(value_min=2)
       .help = "Smallest number of data sets in which internal structure can be judged; a group"
               "is only split from a rest at least this large."
-    min_coherence = 0.03
+    min_coherence = 0.05
       .type = float(value_min=0)
       .help = "A significant group whose coherence (mean residual of its pairwise correlations"
               "from a single population) is at least this large is reported whatever the"
diff --git a/src/dials/algorithms/correlation/groups.py b/src/dials/algorithms/correlation/groups.py
index 3dcfbe6..c52bda0 100644
--- a/src/dials/algorithms/correlation/groups.py
+++ b/src/dials/algorithms/correlation/groups.py
@@ -320,7 +320,7 @@ class GroupDetection:
     significance: float = 0.01
     separation_ratio: float = 3.5
     min_population: int = 5
-    min_coherence: float | None = 0.03
+    min_coherence: float | None = 0.05
     max_depth: int = 8
     exhaustive: int = 200_000
     log: list = field(default_factory=list)
diff --git a/tests/algorithms/correlation/test_groups.py b/tests/algorithms/correlation/test_groups.py
index 9222e04..ac9c057 100644
--- a/tests/algorithms/correlation/test_groups.py
+++ b/tests/algorithms/correlation/test_groups.py
@@ -123,7 +123,7 @@ def varying_majority_and_pair(minority_shift, heterogeneity=0.1, seed=11):
     return y, v, m
 
 
-@pytest.mark.parametrize("minority_shift", [0.2, 0.25, 0.3])
+@pytest.mark.parametrize("minority_shift", [0.3, 0.35, 0.4])
 def test_minority_in_a_continuously_varying_majority(minority_shift):
     # the two data sets set apart are found and the majority is not split: half of the
     # majority, rejected as a group of its own, goes back to the other half and not to the
@@ -133,10 +133,10 @@ def test_minority_in_a_continuously_varying_majority(minority_shift):
 
 
 def test_min_coherence_finds_a_group_beside_a_structured_majority():
-    # the pair is only about twice as coherent as the strongest structure inside the varying
-    # majority, so separation_ratio alone does not report it; its coherence (about 0.05)
-    # does
-    y, v, m = varying_majority_and_pair(0.25)
+    # the pair is about three times as coherent as the strongest structure inside the
+    # varying majority, so separation_ratio alone does not report it; its coherence (about
+    # 0.07, above min_coherence) does
+    y, v, m = varying_majority_and_pair(0.3)
     assert detect(y, v, m, min_coherence=None) == [list(range(14))]
     assert detect(y, v, m) == [list(range(12)), [12, 13]]
 
