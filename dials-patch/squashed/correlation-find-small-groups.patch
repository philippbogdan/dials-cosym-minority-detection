+def test_min_group_size():
+    # groups smaller than the minimum are not taken out: their data sets keep their OPTICS labels
+    labels = [0] * 16
+    groups = [np.arange(0, 9), np.array([9, 10]), np.array([11, 12, 13, 14, 15])]
+    assert take_out_groups(labels, groups, 5).tolist() == [0] * 11 + [1] * 5
+    assert take_out_groups(labels, groups, 2).tolist() == [0] * 9 + [2, 2] + [1] * 5
+    # which groups are taken out is decided on all of them: two populations of about half the
+    # data sets and a small group stay two clusters (merged into one of them, the small group
+    # would make that one the background population)
+    groups = [np.arange(0, 5), np.arange(5, 10), np.array([10, 11])]
+    assert take_out_groups([0] * 12, groups, 5).tolist() == [1] * 5 + [2] * 5 + [0, 0]
+
