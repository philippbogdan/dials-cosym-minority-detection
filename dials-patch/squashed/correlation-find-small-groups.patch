+def test_combine_groups():
+    # the first run reports a pair; the second a triple elsewhere and a group overlapping the
+    # pair: the triple is added, the overlapping group is not, the rest is the background
+    first = [list(range(2, 12)), [0, 1]]
+    second = [[0, 1, 2, 3, 4, 5, 9, 10, 11], [6, 7, 8], [1, 2]]
+    assert sorted(
+        sorted(int(i) for i in g) for g in combine_groups(first, second, 12)
+    ) == [[0, 1], [2, 3, 4, 5, 9, 10, 11], [6, 7, 8]]
+    # nothing reported by either: one population
+    assert [
+        sorted(g.tolist())
+        for g in combine_groups([list(range(6))], [list(range(6))], 6)
+    ] == [list(range(6))]
