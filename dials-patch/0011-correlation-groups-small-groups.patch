diff --git a/src/dials/algorithms/correlation/groups.py b/src/dials/algorithms/correlation/groups.py
index 77c8aef..409345c 100644
--- a/src/dials/algorithms/correlation/groups.py
+++ b/src/dials/algorithms/correlation/groups.py
@@ -520,14 +520,39 @@ def take_out_groups(labels, groups):
     return new
 
 
-def apply_min_group_size(groups, min_group_size):
+def group_evidence(r, w, deltas, members):
+    """How precisely a group stands out: its coherence (mean rank-1 residual within), the standard
+    error of that mean over the counting-noise replicates (each refitted), and the strongest
+    structure of its size inside the rest (the detector's decoy)."""
+    r = np.array(r, dtype=float)
+    np.fill_diagonal(r, 0.0)
+    w = np.asarray(w, dtype=float)
+    members = np.asarray(members)
+    e, _ = _residuals(r, w)
+    valid = (w > 0) & np.any(np.asarray(deltas) != 0, axis=0)
+    np.fill_diagonal(valid, False)
+    e = np.where(valid, e, np.nan)
+    reps = []
+    for d in deltas:
+        rb = r + d
+        np.fill_diagonal(rb, 0.0)
+        v = _mean_within(np.where(valid, _residuals(rb, w)[0], np.nan), members)
+        if np.isfinite(v):
+            reps.append(v)
+    rest = np.setdiff1d(np.arange(len(r)), members)
+    coherence = _mean_within(e, members)
+    se = float(np.std(reps)) if len(reps) > 2 else np.inf
+    return coherence, se, decoy(e, [rest], len(members))
+
+
+def apply_min_group_size(groups, min_group_size, keep=None):
     """The populations with every group smaller than min_group_size returned to the background (the
-    largest population), largest first."""
+    largest population), largest first; `keep(group)` can admit a smaller group nonetheless."""
     groups = sorted((np.asarray(g) for g in groups), key=len, reverse=True)
     if len(groups) <= 1:
         return groups
-    kept = [g for g in groups[1:] if len(g) >= min_group_size]
-    small = [g for g in groups[1:] if len(g) < min_group_size]
+    kept = [g for g in groups[1:] if len(g) >= min_group_size or (keep is not None and keep(g))]
+    small = [g for g in groups[1:] if not (len(g) >= min_group_size or (keep is not None and keep(g)))]
     background = np.sort(np.concatenate([groups[0]] + small)) if small else groups[0]
     return sorted([background] + kept, key=len, reverse=True)
 
