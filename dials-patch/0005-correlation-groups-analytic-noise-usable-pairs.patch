+def test_data_sets_without_usable_correlations_are_not_judged():
+    # two data sets that share too few reflections with the others for a correlation with
+    # an error stay with the largest group rather than forming one of their own
+    y, v, m = synthetic([12, 2], shift=0.4, seed=3)
+    m[12:, 4:] = False
+    assert detect(y, v, m) == [list(range(14))]
+
+
+def test_a_pair_needs_pair_significance():
+    # a pair just significant at 0.01 is not reported when pairs need 0.001
+    y, v, m = synthetic([12, 2], shift=0.4, seed=3)
+    assert detect(y, v, m, pair_significance=1e-300, significance=1.0) == [list(range(14))]
