+@pytest.mark.parametrize("space_group", ["P2", "I23"])
+def test_dense_correlations_match_cosym(space_group):
+    group = sgtbx.space_group_info(symbol=space_group).group()
+    datasets, _ = generate_test_data(space_group=group, sample_size=8)
+    intensities = datasets[0]
+    ids = np.zeros(intensities.size())
+    for i, d in enumerate(datasets[1:], start=1):
+        intensities = intensities.concatenate(d, assert_is_similar_symmetry=False)
+        ids = np.concatenate([ids, np.full(d.size(), i)])
+    lattice = intensities.space_group().build_derived_patterson_group()
+    t = cosym_target.Target(
+        intensities, ids.astype(int), weights="count", lattice_group=lattice,
+        cc_weights="sigma",
+    )
+    y, v, m = dense_from_target(t)
+    r = weighted_cc_matrix(y, v, m)
+    expected = np.array(t.rij_matrix)
+    np.fill_diagonal(expected, 0)
+    assert np.allclose(r, expected, atol=1e-10)
