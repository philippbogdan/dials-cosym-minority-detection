# The proposed procedure as evaluated (frozen in PREREGISTRATION.md amendment 6, tag
# frozen-v3): today's DIALS 3.30.1 defaults, plus the calibrated small-group detector of
# dials-patch/0001-0004 (min_coherence 0.05 for a pair, 0.05 * 2 / k for a group of k).
significant_clusters.find_small_groups = True
significant_clusters.groups.significance = 0.01
significant_clusters.groups.separation_ratio = 3.5
significant_clusters.groups.min_population = 5
significant_clusters.groups.min_coherence = 0.05
significant_clusters.groups.n_bootstrap = 100
significant_clusters.groups.seed = 0
