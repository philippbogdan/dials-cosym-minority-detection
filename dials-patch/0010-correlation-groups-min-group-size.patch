+def test_min_group_size():
+    # groups smaller than the minimum return to the largest population
+    groups = [np.arange(0, 9), np.array([9, 10]), np.array([11, 12, 13, 14, 15])]
+    out = apply_min_group_size(groups, 5)
+    assert [g.tolist() for g in out] == [list(range(0, 11)), [11, 12, 13, 14, 15]]
+    assert [g.tolist() for g in apply_min_group_size(groups, 2)] == [
+        list(range(0, 9)),
+        [11, 12, 13, 14, 15],
+        [9, 10],
+    ]
+
