+def test_effective_sizes_are_cosyms_weights():
+    # cosym's wij (weights="count", cc_weights="sigma") are the effective numbers of
+    # reflections of the pairs, rescaled by one factor
+    group = sgtbx.space_group_info(symbol="P2").group()
+    datasets, _ = generate_test_data(space_group=group, sample_size=8)
+    intensities = datasets[0]
+    ids = np.zeros(intensities.size())
+    for i, d in enumerate(datasets[1:], start=1):
+        intensities = intensities.concatenate(d, assert_is_similar_symmetry=False)
+        ids = np.concatenate([ids, np.full(d.size(), i)])
+    lattice = intensities.space_group().build_derived_patterson_group()
+    t = cosym_target.Target(
+        intensities,
+        ids.astype(int),
+        weights="count",
+        lattice_group=lattice,
+        cc_weights="sigma",
+    )
+    n_eff = effective_sizes(*dense_from_target(t))
+    w = np.array(t.wij_matrix)
+    iu = np.triu_indices(len(w), 1)
+    assert np.allclose(w[iu] / n_eff[iu], (w[iu] / n_eff[iu]).mean(), rtol=1e-6)
+
