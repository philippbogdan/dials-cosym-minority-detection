+def test_analytic_noise_is_the_error_of_fishers_z():
+    r = np.full((6, 6), 0.9)
+    np.fill_diagonal(r, 0)
+    n_eff = np.full((6, 6), 103.0)
+    d = analytic_replicates(r, n_eff, n_replicates=4000, seed=3)
+    z = np.arctanh(r[0, 1] + d[:, 0, 1])
+    assert abs(z.std() - 0.1) < 0.005  # 1 / sqrt(103 - 3)
+    n_eff[0, 1] = n_eff[1, 0] = 4  # too few reflections for an error: no noise
+    assert not analytic_replicates(r, n_eff, n_replicates=5)[:, 0, 1].any()
+
