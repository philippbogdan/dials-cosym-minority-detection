+def synthetic(sizes, shift=0.0, heterogeneity=0.0, sigma=0.25, nref=2000, seed=0):
+    """Data sets x reflections: populations of the given sizes, each population offset by
+    `shift` along its own pattern, crystal-to-crystal variation of `heterogeneity` along a
+    shared pattern (one population with continuous variation) and counting noise."""
+    rng = np.random.default_rng(seed)
+    mu = rng.exponential(1.0, nref)
+    shared = rng.standard_normal(nref)
+    rows = []
+    for size in sizes:
+        pattern = rng.standard_normal(nref)
+        for _ in range(size):
+            state = heterogeneity * rng.standard_normal()
+            rows.append(mu + shift * pattern + state * shared)
+    y = np.array(rows) + sigma * rng.standard_normal((len(rows), nref))
+    v = np.full(y.shape, sigma**2)
+    m = rng.random(y.shape) < 0.8
+    return y, v, m
+
+
+def detect(y, v, m, noise_model="analytic", n_replicates=60, **kwargs):
+    r = weighted_cc_matrix(y, v, m)
+    w = np.ones_like(r)
+    np.fill_diagonal(w, 0)
+    deltas = noise_replicates(
+        y, v, m, r, model=noise_model, n_replicates=n_replicates, seed=1
+    )
+    groups = GroupDetection(r, w, deltas, **kwargs).run()
+    return sorted(sorted(int(i) for i in g) for g in groups)
+
