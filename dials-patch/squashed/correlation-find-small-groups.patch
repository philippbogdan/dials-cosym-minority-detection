+def test_bootstrap_replicates_equal_recomputed_matrices():
+    # each replicate is the weighted correlation matrix recomputed with that replicate's
+    # Poisson weights on the reflections
+    y, v, m = synthetic([6, 3], shift=0.4, nref=300, seed=4)
+    m[0, 150:] = False
+    m[7, :297] = False  # shares three reflections with the others at most
+    reps = bootstrap_replicates(y, v, m, n_bootstrap=7, seed=5)
+    rng = np.random.default_rng(5)
+    r0 = weighted_cc_matrix(y, v, m)
+    for b in range(7):
+        expected = weighted_cc_matrix(y, v, m, rng.poisson(1.0, y.shape[1])) - r0
+        assert np.allclose(reps[b], expected, rtol=0, atol=1e-10)
