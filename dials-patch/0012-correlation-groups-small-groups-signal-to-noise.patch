diff --git a/src/dials/algorithms/correlation/groups.py b/src/dials/algorithms/correlation/groups.py
index 409345c..1308997 100644
--- a/src/dials/algorithms/correlation/groups.py
+++ b/src/dials/algorithms/correlation/groups.py
@@ -545,6 +545,21 @@ def group_evidence(r, w, deltas, members):
     return coherence, se, decoy(e, [rest], len(members))
 
 
+def small_group_admitted(coherence, se, decoy, k, min_signal_to_noise=30, z=2, min_coherence=0.01,
+                         min_ratio=1.5, max_se=None):
+    """Whether a group of k data sets smaller than the minimum group size is reported nonetheless
+    (group_evidence gives coherence, se and decoy): its coherence stands min_signal_to_noise standard
+    errors out of the counting noise, z standard errors above min_coherence * 2 / k, and min_ratio
+    times above the strongest structure of its size inside the rest. Within-sample structure of a few
+    crystals can be as coherent as a group of another population, but is rarely that far out of its
+    own noise. max_se, if given, also bounds the standard error (0: never)."""
+    if not (np.isfinite(se) and se > 0) or (max_se is not None and se > max_se):
+        return False
+    return bool(coherence >= min_signal_to_noise * se
+                and coherence - z * se >= min_coherence * 2 / k
+                and (decoy <= 0 or coherence / decoy >= min_ratio))
+
+
 def apply_min_group_size(groups, min_group_size, keep=None):
     """The populations with every group smaller than min_group_size returned to the background (the
     largest population), largest first; `keep(group)` can admit a smaller group nonetheless."""
