diff --git a/src/dials/algorithms/correlation/groups.py b/src/dials/algorithms/correlation/groups.py
index 8b06d79..c3e76ba 100644
--- a/src/dials/algorithms/correlation/groups.py
+++ b/src/dials/algorithms/correlation/groups.py
@@ -604,6 +604,12 @@ def small_group_admitted(
     )
 
 
+def admitted_by_any(coherence, se, decoy, k, conditions):
+    """Whether any of several sets of small_group_admitted's conditions admits a group: a small group
+    can stand out by how far it is out of its own noise, or by being precisely measured and strong."""
+    return any(small_group_admitted(coherence, se, decoy, k, **c) for c in conditions)
+
+
 def combine_groups(first, second, n):
     """Populations from two detector runs on the same n data sets (e.g. the two noise
     models): the groups the first reports (every group but its background population, the
diff --git a/tests/algorithms/correlation/test_groups.py b/tests/algorithms/correlation/test_groups.py
index 2e92aa2..6ae8751 100644
--- a/tests/algorithms/correlation/test_groups.py
+++ b/tests/algorithms/correlation/test_groups.py
@@ -9,6 +9,7 @@
 
 from dials.algorithms.correlation.groups import (
     GroupDetection,
+    admitted_by_any,
     analytic_replicates,
     bootstrap_replicates,
     combine_groups,
@@ -445,6 +446,34 @@ def keep(g):
     )  # v8's rule
 
 
+def test_small_groups_either_condition():
+    # a small group is reported when it stands far out of its own noise or when it is precisely
+    # measured and strong (small_groups and small_groups.precise)
+    far = {
+        "min_signal_to_noise": 30,
+        "z": 2,
+        "min_coherence": 0.01,
+        "min_ratio": 1.5,
+        "max_se": None,
+    }
+    near = {
+        "min_signal_to_noise": 0,
+        "z": 2,
+        "min_coherence": 0.04,
+        "min_ratio": 2,
+        "max_se": 0.002,
+    }
+    both = [far, near]
+    # precise and strong, 25 standard errors out: only the second admits it
+    assert not small_group_admitted(0.045, 0.0018, 0.01, 2, **far)
+    assert admitted_by_any(0.045, 0.0018, 0.01, 2, both)
+    # 82 standard errors out, below the second's floor: only the first admits it
+    assert not small_group_admitted(0.033, 0.0004, 0.004, 2, **near)
+    assert admitted_by_any(0.033, 0.0004, 0.004, 2, both)
+    # neither
+    assert not admitted_by_any(0.03, 0.002, 0.005, 2, both)
+
+
 def test_combine_groups():
     # the first run reports a pair; the second a triple elsewhere and a group overlapping the
     # pair: the triple is added, the overlapping group is not, the rest is the background
