{"created": "2024-10-04T14:53:34.843283+00:00", "modified": "2024-10-04T14:53:36.122133+00:00", "id": 13890874, "conceptrecid": "13890873", "doi": "10.5281/zenodo.13890874", "conceptdoi": "10.5281/zenodo.13890873", "doi_url": "https://doi.org/10.5281/zenodo.13890874", "metadata": {"title": "Cows, Pigs and People: Example data of cubic insulin from three different species recorded on Diamond Light Source I24", "doi": "10.5281/zenodo.13890874", "publication_date": "2024-10-04", "description": "<p>Data collected at 100K on 10th May 2024 at I24 (Diamond Light Source) to investigate automatic grouping of datasets containing very subtle differences. Crystals grown by Cicely Tam following standard techniques with coordination from Felicity Bertram. For each of bovine, porcine, and human insulin, 10 degree wedges are included. Insulin from these three sources differ by 1-3 amino acids, but are otherwise structurally isomorphous.&nbsp;</p>\n<p>The purpose of the data upload is to make data available for tutorials using the DIALS toolchain (see e.g. examples at https://github.com/graeme-winter/dials_tutorials) however data are available for all purposes without limitation.&nbsp;</p>\n<p>Key:</p>\n<p>CIX - bovine insulin</p>\n<p>PIX - porcine insulin</p>\n<p>X - human insulin</p>", "access_right": "open", "creators": [{"name": "Thompson, Amy", "affiliation": "Diamond Light Source", "orcid": "0000-0003-2174-2751"}, {"name": "Winter, Graeme", "affiliation": "Diamond Light Source", "orcid": "0000-0003-3165-0420"}], "contributors": [{"name": "Thompson, Amy", "affiliation": "Diamond Light Source", "type": "DataCollector", "orcid": "0000-0003-2174-2751"}, {"name": "Winter, Graeme", "affiliation": "Diamond Light Source", "type": "DataCollector", "orcid": "0000-0003-3165-0420"}, {"name": "Tam, Cicely", "affiliation": null, "type": "Researcher"}, {"name": "Bertram, Felicity", "affiliation": "Diamond Light Source", "type": "Researcher"}], "keywords": ["x-ray diffraction", "diamond light source", "cubic insulin", "multi-crystal data set"], "dates": [{"type": "collected"}], "version": "v1", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "mx"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "13890873"}}]}}, "title": "Cows, Pigs and People: Example data of cubic insulin from three different species recorded on Diamond Light Source I24", "links": {"self": "https://zenodo.org/api/records/13890874", "self_html": "https://zenodo.org/records/13890874", "preview_html": "https://zenodo.org/records/13890874?preview=1", "doi": "https://doi.org/10.5281/zenodo.13890874", "self_doi": "https://doi.org/10.5281/zenodo.13890874", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.13890874", "reserve_doi": "https://zenodo.org/api/records/13890874/draft/pids/doi", "parent": "https://zenodo.org/api/records/13890873", "parent_html": "https://zenodo.org/records/13890873", "parent_doi": "https://doi.org/10.5281/zenodo.13890873", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.13890873", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:13890874/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:13890874/sequence/default", "files": "https://zenodo.org/api/records/13890874/files", "media_files": "https://zenodo.org/api/records/13890874/media-files", "archive": "https://zenodo.org/api/records/13890874/files-archive", "archive_media": "https://zenodo.org/api/records/13890874/media-files-archive", "latest": "https://zenodo.org/api/records/13890874/versions/latest", "latest_html": "https://zenodo.org/records/13890874/latest", "versions": "https://zenodo.org/api/records/13890874/versions", "draft": "https://zenodo.org/api/records/13890874/draft", "access_links": "https://zenodo.org/api/records/13890874/access/links", "access_grants": "https://zenodo.org/api/records/13890874/access/grants", "access_users": "https://zenodo