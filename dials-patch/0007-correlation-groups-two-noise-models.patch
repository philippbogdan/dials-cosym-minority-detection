diff --git a/src/dials/algorithms/correlation/groups.py b/src/dials/algorithms/correlation/groups.py
index dbf5811..6c9acd2 100644
--- a/src/dials/algorithms/correlation/groups.py
+++ b/src/dials/algorithms/correlation/groups.py
@@ -492,3 +492,26 @@ def take_out_groups(labels, groups):
             new[members] = k
             k += 1
     return new
+
+
+def combine_groups(first, second, n):
+    """Populations from two detector runs on the same n data sets (e.g. the two noise
+    models): the groups the first reports (every group but its background population, the
+    largest when it holds more than half of the data sets), then those of the second that
+    share no data set with them; the remaining data sets are the background."""
+
+    def reported(groups):
+        groups = sorted((np.asarray(g) for g in groups), key=len, reverse=True)
+        if len(groups) <= 1:
+            return []
+        return groups[1:] if 2 * len(groups[0]) > n else groups
+
+    out = reported(first)
+    taken = {int(i) for g in out for i in g}
+    for g in reported(second):
+        members = {int(i) for i in g}
+        if not members & taken:
+            out.append(np.asarray(g))
+            taken |= members
+    rest = np.array(sorted(set(range(n)) - taken), dtype=int)
+    return ([rest] if len(rest) else []) + out
diff --git a/tests/algorithms/correlation/test_groups.py b/tests/algorithms/correlation/test_groups.py
index 16c318f..453d270 100644
--- a/tests/algorithms/correlation/test_groups.py
+++ b/tests/algorithms/correlation/test_groups.py
@@ -13,6 +13,7 @@
     bootstrap_replicates,
     dense_from_target,
     effective_sizes,
+    combine_groups,
     noise_replicates,
     rank1_fit,
     take_out_groups,
@@ -265,3 +266,15 @@ def test_take_out_groups():
     assert take_out_groups([0, 0, 0, -1], [[0, 1], [2, 3]]).tolist() == [0, 0, 1, 1]
     # one group: the OPTICS labels stand
     assert take_out_groups([0, 0, 1, 1], [[0, 1, 2, 3]]).tolist() == [0, 0, 1, 1]
+
+
+def test_combine_groups():
+    # the first run reports a pair; the second a triple elsewhere and a group overlapping the
+    # pair: the triple is added, the overlapping group is not, the rest is the background
+    first = [list(range(2, 12)), [0, 1]]
+    second = [[0, 1, 2, 3, 4, 5, 9, 10, 11], [6, 7, 8], [1, 2]]
+    assert sorted(sorted(int(i) for i in g) for g in combine_groups(first, second, 12)) == [
+        [0, 1], [2, 3, 4, 5, 9, 10, 11], [6, 7, 8]]
+    # nothing reported by either: one population
+    assert [sorted(g.tolist()) for g in combine_groups([list(range(6))], [list(range(6))], 6)] == [
+        list(range(6))]
