diff --git a/src/dials/algorithms/correlation/groups.py b/src/dials/algorithms/correlation/groups.py
index 1ff555e..77c8aef 100644
--- a/src/dials/algorithms/correlation/groups.py
+++ b/src/dials/algorithms/correlation/groups.py
@@ -520,6 +520,18 @@ def take_out_groups(labels, groups):
     return new
 
 
+def apply_min_group_size(groups, min_group_size):
+    """The populations with every group smaller than min_group_size returned to the background (the
+    largest population), largest first."""
+    groups = sorted((np.asarray(g) for g in groups), key=len, reverse=True)
+    if len(groups) <= 1:
+        return groups
+    kept = [g for g in groups[1:] if len(g) >= min_group_size]
+    small = [g for g in groups[1:] if len(g) < min_group_size]
+    background = np.sort(np.concatenate([groups[0]] + small)) if small else groups[0]
+    return sorted([background] + kept, key=len, reverse=True)
+
+
