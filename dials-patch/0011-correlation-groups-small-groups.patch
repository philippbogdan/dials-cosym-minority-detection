@@ -340,6 +341,27 @@ def test_min_group_size():
     ]
 
 
+def test_small_groups_admitted_when_precise():
+    # a clear pair (another population) is kept below the minimum group size when its coherence is
+    # precisely measured; with no precision allowed it returns to the background
+    y, v, m = synthetic([12, 2], shift=0.4, seed=3)
+    r = weighted_cc_matrix(y, v, m)
+    w = np.ones_like(r)
+    np.fill_diagonal(w, 0)
+    deltas = noise_replicates(y, v, m, r, model="analytic", n_replicates=60, seed=1)
+    groups = GroupDetection(r, w, deltas).run()
+    assert sorted(len(g) for g in groups) == [2, 12]
+    coherence, se, d = group_evidence(r, w, deltas, np.array([12, 13]))
+    assert coherence > 0 and se > 0
+
+    def keep(g, max_se):
+        c, s, dd = group_evidence(r, w, deltas, g)
+        return s <= max_se and c >= 0.04 and (dd <= 0 or c / dd >= 2)
+
+    assert [len(g) for g in apply_min_group_size(groups, 5, keep=lambda g: keep(g, 1.0))] == [12, 2]
+    assert [len(g) for g in apply_min_group_size(groups, 5, keep=lambda g: keep(g, 0.0))] == [14]
+
+
 def test_combine_groups():
     # the first run reports a pair; the second a triple elsewhere and a group overlapping the
     # pair: the triple is added, the overlapping group is not, the rest is the background
